KAI_HOST=127.0.0.1
KAI_PORT=18081
KAI_DB_PATH=/home/ubuntu/kai-transaction-v1/data/kai-production.db
KAI_PLATFORM_MODE=marketplace
KAI_ALLOW_DEMO=false
KAI_SEED_CATALOG=false
KAI_COOKIE_SECURE=true
KAI_ORDER_RESERVATION_MINUTES=30
KAI_SETTLEMENT_HOLD_HOURS=72
KAI_PLATFORM_FEE_BPS=500
KAI_SUPPLIER_REFERRAL_DEFAULT_BPS=800
KAI_SUPPLIER_REFERRAL_MAX_CENTS=50000
KAI_SUPPLIER_REFERRAL_WINDOW_DAYS=30
KAI_SUPPLIER_REFERRAL_HOLD_DAYS=7
KAI_METERING_TOLERANCE_RATIO=0.02
KAI_WORKER_INTERVAL_SECONDS=30
KAI_REQUIRE_SMS=true
KAI_SMS_PROVIDER=disabled
KAI_OTP_TTL_SECONDS=300
KAI_OTP_MAX_ATTEMPTS=5
KAI_PUBLIC_BASE_URL=https://cloudpay.kai.com
# App/合规发布项：正式资料确认后填写，敏感密钥不要提交到仓库。
KAI_APP_NAME=KAI Cloud
KAI_IOS_BUNDLE_ID=com.kaicloud.marketplace
KAI_ANDROID_PACKAGE_ID=com.kaicloud.marketplace
KAI_AUTH_PROVIDER=kai_identity
KAI_IDENTITY_ISSUER=https://auth.kai.com/api/auth
KAI_IDENTITY_CLIENT_ID=
KAI_IDENTITY_CLIENT_SECRET=
KAI_IDENTITY_REDIRECT_URI=https://cloudpay.kai.com/api/auth/kai/callback
KAI_IDENTITY_MOBILE_REDIRECT_URI=https://cloudpay.kai.com/api/auth/kai/mobile/callback
KAI_MOBILE_APP_CALLBACK_URI=cloudpay://auth/callback
KAI_IDENTITY_AUTHORIZATION_ENDPOINT=https://auth.kai.com/api/auth/oauth2/authorize
KAI_IDENTITY_TOKEN_ENDPOINT=https://auth.kai.com/api/auth/oauth2/token
KAI_IDENTITY_USERINFO_ENDPOINT=https://auth.kai.com/api/auth/oauth2/userinfo
KAI_OPERATOR_LEGAL_NAME=
KAI_OPERATOR_CREDIT_CODE=
KAI_SUPPORT_EMAIL=
KAI_SUPPORT_PHONE=
KAI_ICP_FILING=
KAI_APP_FILING=
# 支付主服务只保存商户标识、适配服务地址和 KAI/适配器之间的独立共享密钥。
# 支付宝/微信官方私钥、证书和 APIv3 密钥必须只放在支付适配服务的受限密钥目录。
KAI_ALIPAY_MERCHANT_ID=
KAI_ALIPAY_ADAPTER_URL=
KAI_ALIPAY_CALLBACK_SECRET=
KAI_ALIPAY_MARKETPLACE_MODE=
KAI_WECHAT_MERCHANT_ID=
KAI_WECHAT_ADAPTER_URL=
KAI_WECHAT_CALLBACK_SECRET=
KAI_WECHAT_MARKETPLACE_MODE=
