[Unit]
Description=KAI Cloud Phase-1 Transaction Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kai-transaction-v1
EnvironmentFile=/home/ubuntu/kai-transaction-v1/.env
EnvironmentFile=-/home/ubuntu/kai-secrets/kai-secrets.env
ExecStart=/home/ubuntu/kai-transaction-v1/.venv/bin/python /home/ubuntu/kai-transaction-v1/server.py
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target
